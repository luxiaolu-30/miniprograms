/* 顶部 Hero */
.hero-card {
  margin-bottom: 24rpx;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.hero-count {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.count-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #6B4226;
}

.count-label {
  font-size: 24rpx;
  color: #B8A89A;
}

.hero-sub {
  font-size: 24rpx;
  color: #7A6655;
}

/* 统计网格 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #2C1810;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: #B8A89A;
  margin-top: 4rpx;
  display: block;
}

/* 类型分布 */
.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #2C1810;
  margin-bottom: 20rpx;
  display: block;
}

.dist-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dist-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dist-label {
  width: 140rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #2C1810;
}

.dist-bar-bg {
  flex: 1;
  height: 16rpx;
  background: #F5F0EB;
  border-radius: 8rpx;
  overflow: hidden;
}

.dist-bar {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.dist-count {
  width: 48rpx;
  text-align: right;
  font-size: 24rpx;
  color: #7A6655;
}

/* 心情分布柱状图 */
.mood-chart {
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  height: 280rpx;
  padding: 20rpx 0;
}

.mood-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.mood-bar-col {
  height: 200rpx;
  display: flex;
  align-items: flex-end;
}

.mood-bar {
  width: 48rpx;
  background: linear-gradient(180deg, #FAAD14 0%, #E8590C 100%);
  border-radius: 8rpx 8rpx 0 0;
  min-height: 4rpx;
  transition: height 0.3s ease;
}

.mood-emoji-sm {
  font-size: 28rpx;
}

/* 存储信息 */
.storage-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.storage-text {
  font-size: 28rpx;
  color: #2C1810;
}

.storage-hint {
  font-size: 22rpx;
  color: #B8A89A;
}

/* 操作 */
.actions-section {
  margin-top: 40rpx;
  margin-bottom: 40rpx;
}
