/* 月份导航 */
.month-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #6B4226;
  border-radius: 50%;
  background: #FFFFFF;
}

.month-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C1810;
}

/* 星期标题 */
.week-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 12rpx;
}

.weekday {
  text-align: center;
  font-size: 24rpx;
  color: #B8A89A;
  padding: 8rpx 0;
}

/* 日历格子 */
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.cal-day {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  position: relative;
}

.has-data {
  background: #FAF5EE;
}

.is-today {
  border: 2rpx solid #6B4226;
}

.is-selected {
  background: #6B4226;
}

.is-selected .day-num {
  color: #FFFFFF;
}

.day-num {
  font-size: 26rpx;
  color: #2C1810;
}

.count-badge {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  min-width: 28rpx;
  height: 28rpx;
  border-radius: 14rpx;
  background: #E8590C;
  color: #FFFFFF;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
}

.is-selected .count-badge {
  background: #FFFFFF;
  color: #6B4226;
}

/* 选中日期详情 */
.selected-section {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #2C1810;
  margin-bottom: 16rpx;
  display: block;
}

.no-data {
  text-align: center;
  color: #B8A89A;
  font-size: 26rpx;
  padding: 32rpx 0;
}

.reflection-brief {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F0EB;
}

.brief-index {
  font-size: 22rpx;
  color: #6B4226;
  background: #FAF5EE;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.brief-title {
  font-size: 26rpx;
  color: #2C1810;
}
