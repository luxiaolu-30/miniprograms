<view class="container">
  <!-- 类型选择 -->
  <view class="section">
    <text class="section-title">这是关于什么的记录？</text>
    <view class="type-grid">
      <view
        wx:for="{{entryTypes}}"
        wx:key="key"
        class="type-item {{selectedType == item.key ? 'type-active' : ''}}"
        style="--type-color: {{item.color}}"
        data-type="{{item.key}}"
        bindtap="onSelectType"
      >
        <text class="type-icon-lg">{{item.icon}}</text>
        <text class="type-label-sm">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 心情选择 -->
  <view class="section">
    <text class="section-title">现在的心情如何？</text>
    <view class="mood-row">
      <view
        wx:for="{{moodLevels}}"
        wx:key="value"
        class="mood-item {{selectedMood == item.value ? 'mood-active' : ''}}"
        data-mood="{{item.value}}"
        bindtap="onSelectMood"
      >
        <text class="mood-emoji-lg">{{item.emoji}}</text>
        <text class="mood-label-sm">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 标题输入 -->
  <view class="section">
    <text class="section-title">标题</text>
    <input
      class="title-input"
      placeholder="给这段记录起个名字..."
      value="{{title}}"
      bindinput="onTitleInput"
      maxlength="30"
    />
  </view>

  <!-- 内容输入 -->
  <view class="section">
    <text class="section-title">内容</text>
    <textarea
      class="content-input"
      placeholder="{{typePlaceholder}}"
      value="{{content}}"
      bindinput="onContentInput"
      maxlength="1000"
      auto-height
    />
  </view>

  <!-- 标签 -->
  <view class="section">
    <text class="section-title">标签（可选）</text>
    <view class="tag-row">
      <view wx:for="{{tags}}" wx:key="*this" class="tag-item">
        <text>#{{item}}</text>
        <text class="tag-remove" data-index="{{index}}" bindtap="onRemoveTag">×</text>
      </view>
      <input
        class="tag-input"
        placeholder="添加标签..."
        value="{{tagInput}}"
        bindinput="onTagInput"
        bindconfirm="onAddTag"
        maxlength="10"
      />
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-section">
    <button class="btn-primary btn-large btn-block" bindtap="onSave" disabled="{{saving}}">
      {{saving ? '保存中...' : '保存并生成回顾计划'}}
    </button>
  </view>
</view>
