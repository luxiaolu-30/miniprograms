.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #2C1810;
  margin-bottom: 20rpx;
  display: block;
}

/* 类型选择网格 */
.type-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 2rpx solid transparent;
}

.type-active {
  border-color: var(--type-color);
  background: color-mix(in srgb, var(--type-color) 10%, white);
}

.type-icon-lg {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.type-label-sm {
  font-size: 22rpx;
  color: #7A6655;
}

/* 心情选择 */
.mood-row {
  display: flex;
  gap: 16rpx;
}

.mood-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 2rpx solid transparent;
}

.mood-active {
  border-color: #6B4226;
  background: #FAF5EE;
}

.mood-emoji-lg {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.mood-label-sm {
  font-size: 20rpx;
  color: #7A6655;
}

/* 标题输入 */
.title-input {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #2C1810;
}

/* 内容输入 */
.content-input {
  width: 100%;
  min-height: 240rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #2C1810;
  box-sizing: border-box;
}

/* 标签 */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.tag-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: #FAF5EE;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #6B4226;
}

.tag-remove {
  font-size: 28rpx;
  color: #B8A89A;
  padding: 0 4rpx;
}

.tag-input {
  flex: 1;
  min-width: 160rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
}

/* 保存按钮 */
.save-section {
  margin-top: 48rpx;
  margin-bottom: 48rpx;
}
