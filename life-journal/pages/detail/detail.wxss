/* 条目头部 */
.entry-header {
  margin-bottom: 24rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.type-badge-lg {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.internalized-badge {
  font-size: 22rpx;
  color: #52C41A;
  background: #F6FFED;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.entry-title-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #2C1810;
  display: block;
  margin-bottom: 16rpx;
}

.entry-meta {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.meta-date {
  font-size: 24rpx;
  color: #B8A89A;
}

.entry-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
  color: #7A6655;
  border-radius: 12rpx;
}

.tab-active {
  background: #6B4226;
  color: #FFFFFF;
}

/* 内容 */
.tab-content {
  padding-bottom: 40rpx;
}

.content-text {
  font-size: 28rpx;
  color: #2C1810;
  line-height: 1.8;
}

/* 进度条 */
.progress-bar {
  margin-bottom: 24rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.progress-label {
  font-size: 26rpx;
  color: #2C1810;
}

.progress-count {
  font-size: 26rpx;
  color: #6B4226;
  font-weight: 600;
}

.progress-track {
  height: 12rpx;
  background: #F5F0EB;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6B4226, #8B5E3C);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-dots-row {
  display: flex;
  justify-content: space-between;
}

.progress-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  background: #F5F0EB;
  color: #B8A89A;
}

.dot-done {
  background: #6B4226;
  color: #FFFFFF;
}

/* 回顾时间线 */
.timeline-item {
  position: relative;
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.timeline-index {
  font-size: 26rpx;
  font-weight: 600;
  color: #6B4226;
}

.timeline-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.status-done {
  background: #F6FFED;
  color: #52C41A;
}

.status-skipped {
  background: #FFF7E6;
  color: #FAAD14;
}

.status-pending {
  background: #F5F0EB;
  color: #B8A89A;
}

.timeline-prompt {
  font-size: 24rpx;
  color: #7A6655;
  display: block;
  margin-bottom: 16rpx;
}

.timeline-reflection {
  background: #FAF5EE;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}

.reflection-text {
  font-size: 26rpx;
  color: #2C1810;
  line-height: 1.6;
  display: block;
  margin-bottom: 12rpx;
}

.reflection-meta {
  display: flex;
  justify-content: flex-end;
}

.rating-stars {
  font-size: 22rpx;
  color: #B8A89A;
}

.timeline-date {
  font-size: 22rpx;
  color: #B8A89A;
}

/* 操作按钮 */
.actions-bottom {
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}

.btn-delete {
  text-align: center;
  padding: 24rpx;
  font-size: 28rpx;
  color: #E74C3C;
  background: #FFF2F0;
  border-radius: 16rpx;
}
