.streak-container {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FFF5E6 0%, #FFE4CC 100%);
}

.flame-icon {
  font-size: 28rpx;
}

.streak-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #E8590C;
}

.streak-label {
  font-size: 22rpx;
  color: #D4680A;
}

/* 火焰大小变体 */
.flame-medium .flame-icon {
  font-size: 36rpx;
}
.flame-medium .streak-num {
  font-size: 40rpx;
}

.flame-large .flame-icon {
  font-size: 44rpx;
  animation: flicker 1.5s ease-in-out infinite;
}
.flame-large .streak-num {
  font-size: 48rpx;
}

@keyframes flicker {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}
