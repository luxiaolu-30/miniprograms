.entry-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(107, 66, 38, 0.06);
}

.entry-card:active {
  opacity: 0.92;
}

/* 头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.type-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.type-icon {
  margin-right: 6rpx;
}

.card-date {
  font-size: 22rpx;
  color: #B8A89A;
}

/* 标题 */
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C1810;
  margin-bottom: 12rpx;
  display: block;
}

/* 内容摘要 */
.card-content {
  font-size: 26rpx;
  color: #7A6655;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 16rpx;
}

/* 底部 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mood {
  font-size: 28rpx;
}

/* 回顾进度 */
.progress-mini {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.progress-dots {
  display: flex;
  gap: 6rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E8E0D8;
}

.dot-done {
  background: #6B4226;
}

.progress-text {
  font-size: 22rpx;
  color: #B8A89A;
}
