.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx;
  max-height: 80vh;
  overflow-y: auto;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-section {
  margin-bottom: 32rpx;
}

.modal-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.method-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.method-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 8rpx;
  border-radius: var(--radius-sm);
  background: #f5f5f5;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.method-item.selected {
  background: #FFF3E0;
  border-color: var(--color-primary);
}

.method-icon {
  font-size: 40rpx;
}

.method-label {
  font-size: 24rpx;
  color: var(--color-text);
}

.modal-picker {
  background: #f5f5f5;
  border-radius: var(--radius-sm);
  padding: 24rpx;
  font-size: 28rpx;
}

.modal-input {
  background: #f5f5f5;
  border-radius: var(--radius-sm);
  padding: 24rpx;
  font-size: 28rpx;
}

.modal-textarea {
  background: #f5f5f5;
  border-radius: var(--radius-sm);
  padding: 24rpx;
  font-size: 28rpx;
  width: 100%;
  min-height: 120rpx;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  border-radius: var(--radius-md);
  font-size: 30rpx;
}

.modal-btn-cancel {
  background: #f5f5f5;
  color: var(--color-text);
}

.modal-btn-confirm {
  background: var(--color-primary);
  color: #fff;
}
