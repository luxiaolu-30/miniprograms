.container {
  min-height: 100vh;
}

.filter-scroll {
  white-space: nowrap;
  padding: 16rpx 0;
}

.filter-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 24rpx;
}

.filter-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: #fff;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
}

.filter-chip.active {
  background: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
}

.archive-list {
  padding: 8rpx 24rpx 40rpx;
}

.archive-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.archive-left {
  flex-shrink: 0;
}

.archive-category-icon {
  font-size: 48rpx;
}

.archive-mid {
  flex: 1;
  min-width: 0;
}

.archive-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.archive-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

.archive-date {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.archive-note {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.archive-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
}

.archive-price {
  font-size: 26rpx;
  color: var(--color-warning);
  font-weight: 500;
}

.restore-btn {
  font-size: 24rpx;
  color: var(--color-primary);
  background: var(--color-primary-bg);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}
