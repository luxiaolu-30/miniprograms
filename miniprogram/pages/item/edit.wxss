.edit-page {
  padding: 24rpx 0 200rpx;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

.required {
  color: var(--color-danger);
}

/* 品类选择 */
.category-selector {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: var(--radius-sm);
  padding: 24rpx;
  margin: 0 24rpx;
}

.selected-cat {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.cat-icon-lg {
  font-size: 40rpx;
}

.cat-name-lg {
  font-size: 30rpx;
  color: var(--color-text);
}

.placeholder {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-muted);
}

.arrow {
  font-size: 28rpx;
  color: var(--color-text-muted);
}

/* 名称输入 */
.name-input-wrap {
  background: #fff;
  border-radius: var(--radius-md);
  padding: 28rpx 32rpx;
  margin: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 2rpx solid var(--color-border);
  transition: border-color 0.2s;
}

.name-input-wrap:focus-within {
  border-color: var(--color-primary);
}

.name-input {
  flex: 1;
  font-size: 34rpx;
  font-weight: 500;
  height: 60rpx;
  line-height: 60rpx;
}

.name-count {
  font-size: 22rpx;
  color: var(--color-text-muted);
  flex-shrink: 0;
}

/* 标签 */
.tag-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
}

.tag-input {
  flex: 1;
  background: #fff;
  border-radius: var(--radius-sm);
  padding: 24rpx;
  font-size: 30rpx;
  border: 2rpx solid var(--color-border);
  height: 88rpx;
  box-sizing: border-box;
}

.tag-input:focus {
  border-color: var(--color-primary);
}

.tag-add-btn {
  background: var(--color-primary);
  color: #fff;
  font-size: 28rpx;
  padding: 24rpx 32rpx;
  border-radius: var(--radius-sm);
  height: 88rpx;
  line-height: 40rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 24rpx 0;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #FFF3E0;
  color: var(--color-primary);
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
}

.tag-remove {
  font-size: 20rpx;
  color: var(--color-text-muted);
}

/* 表单行 */
.form-row {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  margin: 0 24rpx 2rpx;
}

.form-row:first-child {
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
}

.form-row:last-child {
  border-radius: 0 0 var(--radius-sm) var(--radius-sm);
}

.form-row-top {
  align-items: flex-start;
}

.row-label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.row-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  text-align: right;
}

.row-value.placeholder {
  color: var(--color-text-muted);
}

.row-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}

.row-textarea {
  flex: 1;
  font-size: 28rpx;
  min-height: 120rpx;
  text-align: left;
}

/* 保存按钮 */
.save-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: #fff;
  border-top: 1rpx solid var(--color-border);
}

.save-btn {
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-md);
  font-size: 32rpx;
  padding: 24rpx;
  border: none;
}

.save-btn::after {
  border: none;
}

.save-btn[disabled] {
  opacity: 0.6;
}

/* 品类选择弹窗 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.picker-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.picker-title {
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.picker-list {
  max-height: 60vh;
}

.picker-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.picker-item.selected {
  background: #FFF8F0;
}

.check {
  margin-left: auto;
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: bold;
}
