<view class="edit-page">
  <!-- 图片选择 -->
  <view class="section">
    <view class="section-title">照片</view>
    <image-picker images="{{images}}" bind:change="onImagesChange" />
  </view>

  <!-- 品类选择 -->
  <view class="section">
    <view class="section-title">分类</view>
    <view class="category-selector" bindtap="onShowCategoryPicker">
      <view wx:if="{{selectedCategory}}" class="selected-cat">
        <text class="cat-icon-lg">{{selectedCategory.icon}}</text>
        <text class="cat-name-lg">{{selectedCategory.name}}</text>
      </view>
      <view wx:else class="placeholder">点击选择分类</view>
      <text class="arrow">▸</text>
    </view>
  </view>

  <!-- 名称 -->
  <view class="section">
    <view class="section-title">名称 <text class="required">*</text></view>
    <view class="name-input-wrap">
      <input
        class="name-input"
        value="{{name}}"
        placeholder="输入物品名称"
        bindinput="onNameInput"
        maxlength="50"
      />
      <text class="name-count">{{name.length}}/50</text>
    </view>
  </view>

  <!-- 动态属性表单 -->
  <view wx:if="{{categoryFields.length > 0}}" class="section">
    <view class="section-title">详细属性</view>
    <dynamic-form
      fields="{{categoryFields}}"
      values="{{fields}}"
      bind:change="onFieldsChange"
    />
  </view>

  <!-- 标签 -->
  <view class="section">
    <view class="section-title">标签</view>
    <view class="tag-input-row">
      <input
        class="tag-input"
        value="{{tagInput}}"
        placeholder="输入标签后回车"
        bindinput="onTagInput"
        bindconfirm="onAddTag"
        maxlength="20"
      />
      <view class="tag-add-btn" bindtap="onAddTag">添加</view>
    </view>
    <view wx:if="{{tags.length > 0}}" class="tag-list">
      <view
        wx:for="{{tags}}"
        wx:key="*this"
        class="tag"
      >
        #{{item}}
        <text class="tag-remove" catchtap="onRemoveTag" data-index="{{index}}">✕</text>
      </view>
    </view>
  </view>

  <!-- 详细信息 -->
  <view class="section">
    <view class="section-title">更多信息</view>

    <view class="form-row">
      <text class="row-label">获取日期</text>
      <picker mode="date" value="{{acquiredDate}}" bindchange="onDateChange">
        <view class="row-value {{acquiredDate ? '' : 'placeholder'}}">
          {{acquiredDate || '选择日期'}}
        </view>
      </picker>
    </view>

    <view class="form-row">
      <text class="row-label">获取方式</text>
      <picker mode="selector" range="{{methodOptions}}" range-key="label" bindchange="onMethodChange">
        <view class="row-value">
          {{acquiredMethod === 'purchased' ? '购买' : acquiredMethod === 'gift' ? '赠送' : acquiredMethod === 'self-made' ? '自制' : '其他'}}
        </view>
      </picker>
    </view>

    <view class="form-row">
      <text class="row-label">价格 (元)</text>
      <input
        class="row-input"
        type="digit"
        value="{{price}}"
        placeholder="可选"
        bindinput="onPriceInput"
      />
    </view>

    <view class="form-row">
      <text class="row-label">存放位置</text>
      <input
        class="row-input"
        value="{{location}}"
        placeholder="如：卧室衣柜"
        bindinput="onLocationInput"
      />
    </view>

    <view class="form-row form-row-top">
      <text class="row-label">备注</text>
      <textarea
        class="row-textarea"
        value="{{note}}"
        placeholder="添加备注..."
        bindinput="onNoteInput"
        maxlength="500"
        auto-height
      />
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-section safe-bottom">
    <button class="save-btn" bindtap="onSave" disabled="{{saving}}">
      {{saving ? '保存中...' : '保存'}}
    </button>
  </view>

  <!-- 品类选择弹窗 -->
  <view wx:if="{{showCategoryPicker}}" class="picker-mask" bindtap="onHideCategoryPicker">
    <view class="picker-panel" catchtap="">
      <view class="picker-title">选择分类</view>
      <scroll-view scroll-y class="picker-list">
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="picker-item {{selectedCategory && selectedCategory.id === item.id ? 'selected' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSelectCategory"
        >
          <text class="cat-icon-lg">{{item.icon}}</text>
          <text class="cat-name-lg">{{item.name}}</text>
          <text wx:if="{{selectedCategory && selectedCategory.id === item.id}}" class="check">✓</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
