<view class="edit-category-page">
  <!-- 基本信息 -->
  <view class="section">
    <view class="section-title">基本信息</view>

    <view class="form-row">
      <text class="row-label">图标</text>
      <view class="icon-selector" bindtap="onShowIconPicker">
        <text class="icon-display">{{icon}}</text>
        <text class="arrow">▸</text>
      </view>
    </view>

    <view class="form-row">
      <text class="row-label">名称</text>
      <input
        class="row-input"
        value="{{name}}"
        placeholder="输入分类名称"
        bindinput="onNameInput"
        maxlength="20"
      />
    </view>
  </view>

  <!-- 自定义属性 -->
  <view class="section">
    <view class="section-title-row">
      <text class="section-title">自定义属性</text>
      <text class="add-field-btn" bindtap="onAddField">+ 添加属性</text>
    </view>

    <view wx:if="{{fields.length === 0}}" class="no-fields">
      暂无自定义属性，点击上方按钮添加
    </view>

    <view
      wx:for="{{fields}}"
      wx:key="key"
      class="field-card {{editingFieldIndex === index ? 'editing' : ''}}"
    >
      <!-- 字段概览 -->
      <view
        class="field-summary"
        data-index="{{index}}"
        bindtap="onEditField"
      >
        <view class="field-summary-left">
          <text class="field-label-preview">{{item.label || '未命名属性'}}</text>
          <text class="field-type-preview">{{item.type === 'text' ? '文本' : item.type === 'number' ? '数字' : item.type === 'select' ? '单选' : item.type === 'date' ? '日期' : '是/否'}}</text>
          <text wx:if="{{item.required}}" class="required-preview">必填</text>
        </view>
        <text class="arrow">▸</text>
      </view>

      <!-- 字段编辑面板 -->
      <view wx:if="{{editingFieldIndex === index}}" class="field-edit-panel">
        <view class="field-edit-row">
          <text class="edit-label">属性名称</text>
          <input
            class="edit-input"
            value="{{item.label}}"
            placeholder="如：作者、颜色"
            data-index="{{index}}"
            bindinput="onFieldLabelChange"
          />
        </view>

        <view class="field-edit-row">
          <text class="edit-label">属性类型</text>
          <picker mode="selector" range="{{fieldTypes}}" range-key="label" data-index="{{index}}" bindchange="onFieldTypeChange">
            <view class="edit-picker">
              {{item.type === 'text' ? '文本' : item.type === 'number' ? '数字' : item.type === 'select' ? '单选' : item.type === 'date' ? '日期' : '是/否'}}
              <text class="picker-arrow">▾</text>
            </view>
          </picker>
        </view>

        <view wx:if="{{item.type === 'select'}}" class="field-edit-row">
          <text class="edit-label">选项</text>
          <input
            class="edit-input"
            value="{{item.optionsStr}}"
            placeholder="用逗号分隔，如：红,蓝,绿"
            data-index="{{index}}"
            bindinput="onFieldOptionsChange"
          />
        </view>

        <view class="field-edit-row field-edit-row-switch">
          <text class="edit-label">必填</text>
          <switch checked="{{item.required}}" color="#8B5E3C" data-index="{{index}}" bindchange="onFieldRequiredToggle" />
        </view>

        <view class="field-edit-actions">
          <view class="field-delete-btn" data-index="{{index}}" catchtap="onDeleteField">删除此属性</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-section safe-bottom">
    <button class="save-btn" bindtap="onSave">保存</button>
  </view>

  <!-- 图标选择弹窗 -->
  <view wx:if="{{showIconPicker}}" class="picker-mask" bindtap="onHideIconPicker">
    <view class="picker-panel" catchtap="">
      <view class="picker-title">选择图标</view>
      <view class="icon-grid">
        <view
          wx:for="{{['👕','📚','📱','🎁','🎵','🎮','👟','👜','🕶️','💍','🧢','🧤','📷','🎨','🏺','🍷','🧸','✈️','🌿','📦']}}"
          wx:key="*this"
          class="icon-grid-item {{icon === item ? 'selected' : ''}}"
          data-icon="{{item}}"
          bindtap="onSelectIcon"
        >
          {{item}}
        </view>
      </view>
    </view>
  </view>
</view>
