/* 全局样式 - 电子衣橱 */
page {
  --color-primary: #8B5E3C;
  --color-primary-light: #D4A574;
  --color-primary-bg: #FAF7F2;
  --color-danger: #E74C3C;
  --color-success: #27AE60;
  --color-warning: #F39C12;
  --color-text: #333333;
  --color-text-secondary: #666666;
  --color-text-muted: #999999;
  --color-border: #E8E0D8;
  --color-bg: #FAF7F2;
  --color-white: #FFFFFF;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;

  background-color: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, button, input, textarea {
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  padding: 24rpx;
  min-height: 100vh;
}

/* 通用按钮 */
.btn-primary {
  background-color: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  padding: 20rpx 40rpx;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background-color: var(--color-white);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-md);
  font-size: 30rpx;
  padding: 20rpx 40rpx;
}

/* 状态标签 */
.badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  font-size: 20rpx;
  line-height: 1.4;
}

.badge-idle {
  background-color: #F0F0F0;
  color: #999;
}

.badge-active {
  background-color: #E8F5E9;
  color: var(--color-success);
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  color: #fff;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(139, 94, 60, 0.35);
  z-index: 100;
  line-height: 1;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: var(--color-border);
  margin: 24rpx 0;
}

/* 文本截断 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 安全区域 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
