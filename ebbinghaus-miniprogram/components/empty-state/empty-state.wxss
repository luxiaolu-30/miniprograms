.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--color-text-muted);
  text-align: center;
  line-height: 1.6;
}

.empty-action {
  margin-top: 32rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 48rpx;
  border-radius: var(--radius-md);
}

.empty-action:active {
  opacity: 0.8;
}
