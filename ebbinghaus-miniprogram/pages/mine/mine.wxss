/* 统计卡片 */
.stats-card {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stat-cell {
  text-align: center;
  color: #fff;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
}

.stat-value.learning {
  color: #FFE082;
}

.stat-value.mastered {
  color: #A5D6A7;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

/* 累计复习 */
.review-summary {
  margin-bottom: 24rpx;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.summary-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.summary-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary);
}

/* 最近录入 */
.section {
  margin-bottom: 24rpx;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
}

.empty-small {
  text-align: center;
  padding: 48rpx 32rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
  background: var(--color-white);
  border-radius: var(--radius-md);
}

.empty-small .empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
  display: block;
}

.recent-list {
  background: var(--color-white);
  border-radius: var(--radius-md);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.recent-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--color-border);
  transition: background 0.15s;
}

.recent-item:active {
  background: var(--color-bg);
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-info {
  flex: 1;
  min-width: 0;
}

.recent-title {
  font-size: 28rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.meta-category {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.mini-progress {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.mini-progress-bar {
  width: 80rpx;
  height: 8rpx;
  background: var(--color-bg);
  border-radius: 4rpx;
  overflow: hidden;
}

.mini-progress-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.mini-progress-text {
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.recent-date {
  font-size: 22rpx;
  color: var(--color-text-muted);
  white-space: nowrap;
  margin-left: 16rpx;
}

/* 快捷入口 */
.quick-links {
  background: var(--color-white);
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.link-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--color-border);
  transition: background 0.15s;
}

.link-item:active {
  background: var(--color-bg);
}

.link-item:last-child {
  border-bottom: none;
}

.link-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.link-text {
  flex: 1;
  font-size: 28rpx;
}

.link-arrow {
  font-size: 32rpx;
  color: var(--color-text-muted);
}

/* 存储信息 */
.storage-info {
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-muted);
  padding: 16rpx;
}
