.form {
  background: var(--color-white);
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: var(--color-danger);
}

.form-input {
  width: 100%;
  padding: 20rpx 24rpx;
  background: var(--color-bg);
  border-radius: var(--radius-md);
  font-size: 32rpx;
  font-weight: 500;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: var(--color-primary);
}

.form-input.error {
  border-color: var(--color-danger);
}

.input-placeholder {
  color: var(--color-text-muted);
  font-weight: 400;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  padding: 16rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.form-textarea:focus {
  border-color: var(--color-primary);
}

/* 图片列表 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  animation: imageIn 0.3s ease;
}

@keyframes imageIn {
  from { opacity: 0; transform: scale(0.8); }
  to { opacity: 1; transform: scale(1); }
}

.image-preview {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-sm);
}

.image-delete {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: var(--color-danger);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(231, 76, 60, 0.3);
}

.image-add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: var(--radius-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.image-add:active {
  border-color: var(--color-primary);
  background: var(--color-primary-bg);
}

.add-icon {
  font-size: 48rpx;
  color: var(--color-text-muted);
}

.add-text {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 8rpx;
}

/* 选择器 */
.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.picker-value:active {
  border-color: var(--color-primary);
}

.picker-arrow {
  font-size: 32rpx;
  color: var(--color-text-muted);
}

/* 保存按钮 */
.save-bar {
  margin-top: 32rpx;
}

.save-btn {
  width: 100%;
  text-align: center;
  transition: all 0.2s;
}

.save-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 分类选择弹窗 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.picker-panel {
  width: 100%;
  background: var(--color-white);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  max-height: 60vh;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.picker-title {
  text-align: center;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-bottom: 1rpx solid var(--color-border);
}

.picker-list {
  max-height: 50vh;
}

.picker-option {
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--color-border);
  transition: background 0.15s;
}

.picker-option:active {
  background: var(--color-bg);
}
