.detail-header {
  background: var(--color-white);
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.detail-title {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}

.detail-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.meta-tag {
  font-size: 24rpx;
  color: var(--color-primary);
  background: var(--color-primary-bg);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
}

.meta-date {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* 进度卡片 */
.progress-card {
  background: var(--color-white);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-title {
  font-size: 28rpx;
  font-weight: 500;
}

.progress-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.progress-bar {
  height: 12rpx;
  background: var(--color-bg);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-primary), var(--color-success));
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.progress-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.mastered-text {
  color: var(--color-success);
  font-weight: 600;
}

/* 内容 */
.detail-content {
  background: var(--color-white);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 26rpx;
  color: var(--color-text-muted);
  margin-bottom: 16rpx;
}

.content-text {
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 图片 */
.detail-images {
  background: var(--color-white);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.detail-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-sm);
  transition: transform 0.2s;
}

.detail-image:active {
  transform: scale(0.95);
}

/* 复习记录 */
.review-history {
  background: var(--color-white);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.review-timeline {
  margin-top: 8rpx;
}

.timeline-item {
  display: flex;
  padding: 16rpx 0;
  border-left: 2rpx solid var(--color-border);
  margin-left: 16rpx;
  padding-left: 32rpx;
  position: relative;
  transition: all 0.3s;
}

.timeline-item.done {
  border-left-color: var(--color-success);
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--color-border);
  position: absolute;
  left: -11rpx;
  top: 24rpx;
  transition: all 0.3s;
}

.timeline-item.done .timeline-dot {
  background: var(--color-success);
  box-shadow: 0 0 0 6rpx rgba(39, 174, 96, 0.2);
}

.timeline-content {
  flex: 1;
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.timeline-title {
  font-size: 26rpx;
  font-weight: 500;
}

.timeline-status {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
}

.timeline-status.done {
  background: #E8F5E9;
  color: var(--color-success);
}

.timeline-status.overdue {
  background: #FDECEA;
  color: var(--color-danger);
}

.timeline-status.pending {
  background: var(--color-bg);
  color: var(--color-text-muted);
}

.timeline-date {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

.timeline-action {
  margin-top: 12rpx;
}

.btn-complete {
  display: inline-block;
  background: var(--color-success);
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-sm);
  transition: all 0.2s;
}

.btn-complete:active {
  transform: scale(0.95);
  opacity: 0.9;
}

/* 操作按钮 */
.action-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  transition: all 0.2s;
}

.action-btn:active {
  transform: scale(0.98);
}

.btn-danger {
  background: var(--color-white);
  color: var(--color-danger);
  border: 2rpx solid var(--color-danger);
  border-radius: var(--radius-md);
  font-size: 30rpx;
  padding: 20rpx 40rpx;
}

.btn-danger::after {
  border: none;
}

.loading {
  text-align: center;
  padding: 80rpx 0;
  color: var(--color-text-muted);
}
