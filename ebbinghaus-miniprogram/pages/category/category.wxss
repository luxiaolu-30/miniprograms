.category-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.category-item {
  background: var(--color-white);
  border-radius: var(--radius-md);
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.item-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.item-icon {
  font-size: 40rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
  flex: 1;
}

.item-count {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.item-actions {
  display: flex;
  gap: 16rpx;
}

.action-icon {
  font-size: 32rpx;
  padding: 8rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-bottom: 32rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-panel {
  width: 80%;
  background: var(--color-white);
  border-radius: var(--radius-lg);
  padding: 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  padding: 16rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
}

.icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.icon-option {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
}

.icon-option.selected {
  border-color: var(--color-primary);
  background: var(--color-primary-bg);
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
}
